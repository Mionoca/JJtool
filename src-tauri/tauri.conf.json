{
  "productName": "JJtool",
  "version": "0.1.0",
  "identifier": "com.jjtool.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JJtool",
        "width": 160,
        "height": 200,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "x": 1200,
        "y": 600
      },
      {
        "label": "pet-menu",
        "title": "JJtool Menu",
        "width": 320,
        "height": 432,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "clipboard",
        "title": "Clipboard History",
        "width": 400,
        "height": 560,
        "minWidth": 320,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "x": 800,
        "y": 200
      },
      {
        "label": "sticky",
        "title": "Sticky Notes - JJtool",
        "width": 320,
        "height": 560,
        "minWidth": 300,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "x": 1400,
        "y": 200
      },
      {
        "label": "news",
        "title": "News - JJtool",
        "width": 360,
        "height": 540,
        "minWidth": 320,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "study",
        "title": "Study - JJtool",
        "width": 360,
        "height": 540,
        "minWidth": 320,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "Settings - JJtool",
        "width": 600,
        "height": 480,
        "minWidth": 420,
        "minHeight": 420,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
